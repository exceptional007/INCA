PORT=3000

# PostgreSQL pooled connection string for application runtime (e.g. Neon PgBouncer pooler)
# Parameters:
# - pgbouncer=true : Required for PgBouncer transaction pooling mode (disables prepared statements)
# - connection_limit=10 : Sized for serverless concurrency without exhausting PostgreSQL max_connections
# - connect_timeout=15 : Seconds before connection attempt times out (accommodates serverless compute cold resume)
# - pool_timeout=20 : Seconds before query engine throws on pool acquisition queue
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/inca_db?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=10&connect_timeout=15&pool_timeout=20"

# Direct PostgreSQL connection string (unpooled, recommended for prisma migrate)
# DIRECT_URL="postgresql://user:password@ep-direct.us-east-2.aws.neon.tech/inca_db?sslmode=require"

JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=http://localhost:5173

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Gemini AI (for timetable PDF parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
