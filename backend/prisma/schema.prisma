generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Role {
  id String @id @default(uuid())

  code        String  @unique
  name        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty Faculty?
  student Student?
  attendanceAudits AttendanceAudit[]
  timetableImportBatches TimetableImportBatch[]

  @@map("users")
}

model Faculty {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeCode String  @unique
  firstName    String
  lastName     String?

  gender      Gender
  dateOfBirth DateTime?

  designation String

  isActive Boolean @default(true)

  phone String?

  photoKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates  ScheduleTemplate[]
  scheduleExceptions ScheduleException[]
  activities         Activity[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  timetableSlotDrafts TimetableSlotDraft[]

  @@map("faculty")
}

model Student {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  collegeId        String @unique
  rollNumber       String @unique
  enrollmentNumber String @unique

  firstName String
  lastName  String?

  gender      Gender
  dateOfBirth DateTime?

  phone String?

  photoKey String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords AttendanceRecord[]

  @@map("students")
}

model Department {
  id String @id @default(uuid())

  code      String  @unique
  name      String  @unique
  shortName String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]

  @@map("departments")
}

model Program {
  id String @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  code      String  @unique
  name      String
  shortName String?

  batches       Batch[]
  semesters     Semester[]
  subjects      Subject[]
  durationYears Int        @default(4)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@map("programs")
}

model AcademicSession {
  id String @id @default(uuid())

  name      String   @unique
  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_sessions")
}

model Batch {
  id String @id @default(uuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  name      String
  startYear Int
  endYear   Int

  isActive Boolean @default(true)

  sections  Section[]
  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, startYear])
  @@map("batches")
}

model Semester {
  id String @id @default(uuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  number Int
  name   String

  isActive Boolean @default(true)

  subjects Subject[]
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, number])
  @@map("semesters")
}

model Section {
  id String @id @default(uuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates ScheduleTemplate[]
  timetableVersions   TimetableVersion[]
  timetableSlotDrafts TimetableSlotDraft[]

  @@unique([batchId, semesterId, name])
  @@map("sections")
}

model Subject {
  id String @id @default(uuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  code String @unique
  name String

  credits Int
  isLab   Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates ScheduleTemplate[]
  timetableSlots      TimetableSlot[]
  timetableSlotDrafts TimetableSlotDraft[]

  @@unique([programId, semesterId, name])
  @@map("subjects")
}

model Room {
  id String @id @default(uuid())

  code String @unique
  name String

  building String?
  floor    Int?
  capacity Int?

  isLab    Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates  ScheduleTemplate[]
  scheduleExceptions ScheduleException[]
  activities         Activity[]
  timetableSlots     TimetableSlot[]
  timetableSlotDrafts TimetableSlotDraft[]

  @@map("rooms")
}

model TimeSlot {
  id String @id @default(uuid())

  name      String
  startTime String
  endTime   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startTime, endTime])
  @@map("time_slots")
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model ScheduleTemplate {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  dayOfWeek Int
  startTime String 
  endTime   String 

  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]

  @@map("schedule_templates")
}

model Schedule {
  id String @id @default(uuid())

  templateId String
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  lectureDate DateTime @db.Date
  status      ScheduleStatus @default(SCHEDULED)
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions         ScheduleException[]
  attendanceSessions AttendanceSession[]

  @@map("schedules")
}

model ScheduleException {
  id String @id @default(uuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  exceptionType String
  reason        String?

  newFacultyId String?
  newFaculty   Faculty? @relation(fields: [newFacultyId], references: [id], onDelete: SetNull)

  newRoomId String?
  newRoom   Room?   @relation(fields: [newRoomId], references: [id], onDelete: SetNull)

  newStartTime String?
  newEndTime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedule_exceptions")
}

model ActivityType {
  id String @id @default(uuid())

  name        String
  description String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("activity_types")
}

model Activity {
  id String @id @default(uuid())

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  title       String
  description String?

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  startTime DateTime
  endTime   DateTime

  attendanceRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessions AttendanceSession[]

  @@map("activities")
}

model AttendanceSession {
  id String @id @default(uuid())

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  takenById String
  takenBy   Faculty @relation(fields: [takenById], references: [id], onDelete: Restrict)

  attendanceDate DateTime @db.Date
  
  status String @default("OPEN") 

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id String @id @default(uuid())

  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status  AttendanceStatus
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits AttendanceAudit[]

  @@unique([attendanceSessionId, studentId])
  @@map("attendance_records")
}

model AttendanceAudit {
  id String @id @default(uuid())

  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  oldStatus String
  newStatus String

  editedById String
  editedBy   User   @relation(fields: [editedById], references: [id], onDelete: Restrict)

  editedAt DateTime @default(now())
  reason   String?

  @@map("attendance_audits")
}

enum ImportBatchStatus {
  UPLOADED
  EXTRACTED
  PENDING_REVIEW
  COMMITTED
  ROLLED_BACK
  EXTRACTION_FAILED
  DISCARDED
}

model TimetableImportBatch {
  id                 String              @id @default(uuid())
  uploadedByUserId   String
  uploadedByUser     User                @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  sourceFileR2Key    String
  status             ImportBatchStatus   @default(UPLOADED)
  pagesJson          Json?               // Stores page numbers, PNG keys, and extracted raw text metadata
  createdAt          DateTime            @default(now())
  committedAt        DateTime?
  notes              String?
  slots              TimetableSlotDraft[]
  timetableVersions  TimetableVersion[]

  @@map("timetable_import_batches")
}

model TimetableSlotDraft {
  id                 String              @id @default(uuid())
  batchId            String
  batch              TimetableImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  gridId             String
  day                String
  timeSlotStart      String
  timeSlotEnd        String
  isMergedSlot       Boolean             @default(false)
  sectionCodes       String[]            // Scalar list of sections mapped (e.g., ["C1", "C2"])
  subjectRaw         String
  facultyRaw         String
  room               String
  category           String              // "academic" | "skill_development" | "placement" | "self_learning"
  matchedSubjectId   String?
  matchedSubject     Subject?            @relation(fields: [matchedSubjectId], references: [id], onDelete: SetNull)
  matchedFacultyId   String?
  matchedFaculty     Faculty?            @relation(fields: [matchedFacultyId], references: [id], onDelete: SetNull)
  matchedRoomId      String?
  matchedRoom        Room?               @relation(fields: [matchedRoomId], references: [id], onDelete: SetNull)
  matchedSectionId   String?
  matchedSection     Section?            @relation(fields: [matchedSectionId], references: [id], onDelete: SetNull)
  matchConfidence    Float               @default(0.0)
  rawCellText        String
  adminEdited        Boolean             @default(false)

  @@map("timetable_slot_drafts")
}

model TimetableVersion {
  id                 String              @id @default(uuid())
  sectionId          String
  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  effectiveFrom      DateTime            @db.Date
  isActive           Boolean             @default(true)
  importBatchId      String?
  importBatch        TimetableImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  slots              TimetableSlot[]

  @@map("timetable_versions")
}

model TimetableSlot {
  id                 String              @id @default(uuid())
  versionId          String
  version            TimetableVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  day                String
  timeSlotStart      String
  timeSlotEnd        String
  subjectId          String
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  facultyId          String
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  roomId             String
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  category           String

  @@map("timetable_slots")
}
